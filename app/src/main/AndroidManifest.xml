<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Only used when the operator explicitly fetches a map from a URL. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Held only while travel recording is armed, and only alongside the
         foreground notification that says so. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        Android Auto. The surface permission is what lets the app draw its own
        map on the head unit rather than being limited to lists and cards; the
        navigation templates permission is what a map-drawing app is required
        to hold.
    -->
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />

    <!--
        largeHeap: a rendered sheet is twenty megabytes of bitmap, terrain
        tiles are a quarter of a megabyte each, and contours are cut from
        elevation grids. The tile cache is bounded, but the default heap on a
        mid-range phone leaves very little margin for all three at once.
    -->
    <application
        android:name=".FirelineApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.FirelineMap">

        <!--
            What the head unit reads to decide whether this app belongs in its
            launcher, and at which library level it can be driven.
        -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <!--
            The map on the head unit. Exported because the Android Auto host is
            another process and has to be able to bind to it; the service's own
            host validator is what decides who may.
        -->
        <service
            android:name=".car.FirelineCarAppService"
            android:exported="true"
            android:label="@string/car_app_name"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
                <!-- Drawn on the instrument cluster too, where the head unit
                     has one. -->
                <category android:name="androidx.car.app.category.FEATURE_CLUSTER" />
            </intent-filter>
            <!--
                Declaring that this app can be navigated with.

                Without it the host does not recognise a navigation app and the
                launcher does not list it, which is exactly how this failed the
                first time.
            -->
            <intent-filter>
                <action android:name="androidx.car.app.action.NAVIGATE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="geo" />
            </intent-filter>
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Accept a PDF from the share sheet, so a map can arrive from a
                 browser download, a file manager, or a messaging app. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <!-- Tracks and pins arriving from somebody else. GPX has no
                 registered MIME type that senders agree on, so the wildcard
                 and the octet-stream form are both needed: a file sent from a
                 message arrives as one and from a file manager as the other. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
            </intent-filter>

            <!-- And accept being opened directly as a PDF viewer. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!--
            Hands a written file to whatever the operator picks in the share
            sheet: Bluetooth, a message, email, a nearby phone. The grant is
            read-only, one file at a time, and expires with the intent.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.shares"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>

        <service
            android:name=".location.TrackRecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
