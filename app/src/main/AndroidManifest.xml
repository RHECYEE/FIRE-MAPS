<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Only used when the operator explicitly fetches a map from a URL. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android Auto. NAVIGATION_TEMPLATES is what a navigation-category app
         needs to be allowed to use NavigationTemplate at all; ACCESS_SURFACE is
         what lets it draw the map onto the car display rather than only filling
         in a list. Both are install-time, so nothing is prompted for in the car. -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />

    <!-- Package visibility. Android 11 and later hide other installed apps
         unless they are declared here, so without this the in-app Android Auto
         check would report the host as not installed on a phone that has it,
         which is the one answer worse than no answer at all. -->
    <queries>
        <package android:name="com.google.android.projection.gearhead" />
        <package android:name="com.google.android.apps.automotive.templates.host" />
        <intent>
            <action android:name="androidx.car.app.CarAppService" />
        </intent>
    </queries>

    <application
        android:name=".FirelineApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Fireline Map"
        android:supportsRtl="true"
        android:theme="@style/Theme.FirelineMap">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Accept a PDF from the share sheet, so a map can arrive from a
                 browser download, a file manager, or a messaging app. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <!-- And accept being opened directly as a PDF viewer. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <service
            android:name=".location.TrackRecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Android Auto discovery.

             All three of these have to be present or the app never reaches the
             car launcher: the descriptor declares that this app drives the
             display with the Car App Library's templates, the API level tells
             the host how old a head unit may be and still be offered the app,
             and the service is what the host actually binds to. A minimum of 1
             is deliberate: the screen checks at runtime before using anything
             newer, so an older unit gets the map rather than nothing. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <service
            android:name=".car.FirelineCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>
    </application>
</manifest>
